# Database connection (Neon production or local dev)
# POSTGRES_URL=postgresql://user:pass@host:5432/dbname
# POSTGRES_URL_NON_POOLING=  # Direct connection (required for pg_dump against Neon)

# Optional: protect setup endpoints (set any random string)
# SETUP_SECRET=your-secret-here

# Path to pg_dump/psql v17 binary (for backup/restore scripts)
# PG_DUMP_PATH=/opt/homebrew/opt/postgresql@17/bin/pg_dump
# PSQL_PATH=/opt/homebrew/opt/postgresql@17/bin/psql
